<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DawnsDew" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#090A0D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.DawnsDew.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090A0D</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DawnsDew</item>
    </style>
</resources>